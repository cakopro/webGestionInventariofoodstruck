<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mi Sistema</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex flex-col min-h-screen">
    <header class="bg-gray-800 text-white shadow-md">
        <nav class="container mx-auto p-4 flex items-center justify-between">
            
            <a href="/index" class="flex items-center gap-2 font-bold text-xl hover:text-blue-300 transition">
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="8" width="18" height="10" rx="2" ry="2" />
                    <line x1="19" y1="12" x2="23" y2="12" />
                    <line x1="19" y1="16" x2="23" y2="16" />
                    <path d="M5 8V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v2" />
                    <circle cx="5" cy="18" r="2" />
                    <circle cx="15" cy="18" r="2" />
                </svg>
                <span>FoodTruck</span>
            </a>

            <ul class="flex space-x-6">
                <li><a href="/Proveedores" class="hover:text-blue-300 transition">Proveedores</a></li>
                <li><a href="/Insumos" class="hover:text-blue-300 transition">Insumos</a></li>
                <li><a href="/Productos" class="hover:text-blue-300 transition">Productos</a></li>
                <li><a href="/Ventas" class="hover:text-blue-300 transition">Ventas</a></li>
            </ul>

            <div class="flex items-center gap-2 bg-gray-700 px-3 py-1 rounded-full">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                <span class="text-sm">Admin</span>
            </div>
        </nav>
    </header>
    <main class="container mx-auto p-8 flex-grow">
        @RenderBody()
    </main>
    <footer class="bg-gray-800 text-gray-400 p-6 mt-auto">
        <div class="container mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-sm">
            
            <p>&copy; 2026 GestionInventario FoodTruck. Todos los derechos reservados.</p>
            
            <div class="flex gap-6">
                <a href="#" class="hover:text-white transition">Facebook</a>
                <a href="#" class="hover:text-white transition">Instagram</a>
                <a href="#" class="hover:text-white transition">Twitter</a>
            </div>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>