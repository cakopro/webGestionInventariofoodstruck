@page
@model webGestionInventario.Pages.agregarEditarProductoModel
@{
    ViewData["Title"] = "Agregar/Editar Producto";
}

<div class="max-w-4xl mx-auto bg-white p-8 rounded-xl shadow-lg border border-gray-200 mt-10">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Nuevo Producto</h2>
    
    <form method="post" class="space-y-6">
        
        <div>
            <label class="block text-sm font-medium text-gray-700">Nombre del Producto</label>
            <input asp-for="NombreProducto" placeholder="Ej: Pastel de Chocolate" required 
                   class="w-full mt-1 border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 outline-none" />
        </div>

        <input type="hidden" id="jsonReceta" name="JsonReceta" value="@Model.JsonReceta" />

        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
            <h3 class="text-lg font-semibold text-gray-700 mb-3">Agregar Ingredientes</h3>
            <div class="flex flex-wrap gap-4 items-end">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-xs text-gray-500">Seleccionar Insumo</label>
                    <select id="insumoSelect" class="w-full border border-gray-300 rounded-lg p-3">
                        @foreach (var i in Model.ListaInsumos)
                        {
                            <option value="@i.Id" data-nombre="@i.Nombre" data-unidad="@i.UnidadMedida">
                                @i.Nombre (@i.UnidadMedida)
                            </option>
                        }
                    </select>
                </div>
                <div class="w-32">
                    <label class="block text-xs text-gray-500">Cantidad</label>
                    <input type="number" id="cantidadInput" step="any" placeholder="0"
                           class="w-full border border-gray-300 rounded-lg p-3 sin-flechas" />
                </div>
                <button type="button" onclick="agregarFila()" 
                        class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-lg transition">
                    Agregar
                </button>
            </div>
        </div>

        <div class="overflow-hidden border border-gray-200 rounded-lg">
            <table id="tablaReceta" class="w-full text-left border-collapse">
                <thead class="bg-gray-100 text-gray-600 uppercase text-sm">
                    <tr>
                        <th class="px-6 py-3">Insumo</th>
                        <th class="px-6 py-3">Cantidad</th>
                        <th class="px-6 py-3 text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200" id="tbodyReceta">
                    </tbody>
            </table>
        </div>

        <div class="flex justify-end">
            <button type="submit" asp-page-handler="Guardar" 
                    class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-10 rounded-lg shadow-md transition">
                Guardar Producto Final
            </button>
        </div>
    </form>

    <script>
        let receta = JSON.parse(document.getElementById('jsonReceta').value || '[]');
        renderizarTabla();

         function agregarFila() {
                let select = document.getElementById('insumoSelect');
                let cant = document.getElementById('cantidadInput').value;
    
                let cantidadNumerica = parseFloat(cant);
                if(!cant || isNaN(cantidadNumerica) || cantidadNumerica <= 0) return;

                let option = select.options[select.selectedIndex];
                receta.push({
                    IdInsumo: parseInt(select.value, 10), 
                    NombreInsumo: option.getAttribute('data-nombre'),
                    Cantidad: cantidadNumerica,
                    UnidadMedida: option.getAttribute('data-unidad')
                });

                document.getElementById('jsonReceta').value = JSON.stringify(receta);
                renderizarTabla();
                document.getElementById('cantidadInput').value = '';
            }

        function renderizarTabla() {
            let tbody = document.querySelector('#tbodyReceta');
            tbody.innerHTML = '';
            receta.forEach((item, index) => {
                tbody.innerHTML += `
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 font-medium text-gray-900">${item.NombreInsumo}</td>
                        <td class="px-6 py-4 text-gray-600">${item.Cantidad} ${item.UnidadMedida}</td>
                        <td class="px-6 py-4 text-center">
                            <button type="button" onclick="quitarFila(${index})" 
                                    class="text-red-600 hover:text-red-800 font-bold">Eliminar</button>
                        </td>
                    </tr>`;
            });
        }
        
        function quitarFila(index) {
            receta.splice(index, 1);
            document.getElementById('jsonReceta').value = JSON.stringify(receta);
            renderizarTabla();
        }
    </script>
</div>