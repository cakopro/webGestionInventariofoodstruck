@page
@model webGestionInventario.Pages.VentasModel
@{
    ViewData["Title"] = "Punto de Venta";
}

<div class="max-w-7xl mx-auto p-6 space-y-6">
    
    <form method="post" id="formVenta">
        <div asp-validation-summary="All" class="bg-red-100 text-red-700 p-3 rounded font-bold mb-4"></div>
        <input type="hidden" asp-for="DetallesJson" id="inputDetallesJson" />

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <div class="md:col-span-1 bg-white p-6 rounded-lg shadow-md border">
                <h2 class="text-xl font-bold mb-4 text-gray-700">Seleccionar Producto</h2>
                <div class="space-y-4">
                    
                    <div>
                        <label class="block text-sm font-medium">Nombre Cliente:</label>
                        <input type="text" asp-for="NuevaVenta.NombreCliente" class="w-full border p-2 rounded" placeholder="Ingrese nombre" required>
                    </div>

                    <div>
                        <label class="block text-sm font-medium">Producto:</label>
                        <select id="selectProducto" class="w-full border p-2 rounded">
                            <option value="">-- Seleccione --</option>
                            @foreach (var p in Model.ListaProductos)
                            {
                                <option value="@p.Id" data-precio="@p.PrecioVenta">@p.Nombre ($@p.PrecioVenta.ToString("N0", new System.Globalization.CultureInfo("es-CL")))</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium">Cantidad:</label>
                        <input type="number" id="inputCantidad" class="w-full border p-2 rounded" value="1" min="1"
                               oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value < 1) this.value = 1;">
                    </div>
                    
                    <button id="btnAgregar" type="button" class="w-full inline-flex items-center justify-center gap-2 bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition font-semibold shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        Agregar a la Lista
                    </button>
                </div>
            </div>

            <div class="md:col-span-2 bg-white p-6 rounded-lg shadow-md border">
                <h2 class="text-xl font-bold mb-4 text-gray-700">Detalle de la Venta</h2>

                <table class="w-full text-sm text-left border mb-4">
                    <thead class="bg-gray-100 uppercase">
                        <tr>
                            <th class="p-2 border">Producto</th>
                            <th class="p-2 border text-center">Cant</th>
                            <th class="p-2 border text-right">Precio</th>
                            <th class="p-2 border text-right">Subtotal</th>
                            <th class="p-2 border text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tablaDetallesBody"></tbody>
                </table>

                <div class="border-t pt-4">
                    <div class="flex justify-end gap-6 text-lg font-bold mb-4">
                        <span>IVA(19%): <span id="resumenIVA">$0</span></span>
                        <span>Total: <span id="resumenTotal">$0</span></span>
                    </div>
                    <button type="submit" class="w-full inline-flex items-center justify-center gap-2 bg-green-600 text-white py-3 rounded-lg text-lg font-bold hover:bg-green-700 transition shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                        </svg>
                        Finalizar Venta
                    </button>
                </div>
            </div>
        </div>
    </form>

    <div class="bg-white p-6 rounded-lg shadow-md border">
        <h2 class="text-xl font-bold mb-4 text-gray-700">Historial de Ventas</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left border">
                <thead class="bg-gray-100 uppercase">
                    <tr>
                        <th class="p-2 border">Fecha</th>
                        <th class="p-2 border">Cliente</th>
                        <th class="p-2 border">Producto</th>
                        <th class="p-2 border text-right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.HistorialVentas)
                    {
                        <tr>
                            <td class="p-2 border">@v.Fecha.ToString("dd-MM-yyyy HH:mm:ss")</td>
                            <td class="p-2 border">@v.Cliente</td>
                            <td class="p-2 border text-blue-600 font-medium">@v.ProductosResumen</td>
                            <td class="p-2 border text-right font-bold">$@v.Total.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="modalEditar" class="fixed inset-0 bg-gray-900 bg-opacity-50 hidden justify-center items-center z-50">
    <div class="bg-white p-6 rounded-lg shadow-xl border max-w-md w-full m-4 space-y-4">
        <h3 class="text-lg font-bold text-gray-700 border-b pb-2">Actualizar Item de la Lista</h3>
        
        <input type="hidden" id="modalEditOriginalId" />

        <div>
            <label class="block text-sm font-medium mb-1">Cambiar Producto:</label>
            <select id="modalSelectProducto" class="w-full border p-2 rounded">
                @foreach (var p in Model.ListaProductos)
                {
                    <option value="@p.Id" data-precio="@p.PrecioVenta">@p.Nombre ($@p.PrecioVenta.ToString("N0", new System.Globalization.CultureInfo("es-CL")))</option>
                }
            </select>
        </div>
        
        <div>
            <label class="block text-sm font-medium mb-1">Nueva Cantidad:</label>
            <input type="number" id="modalInputCantidad" class="w-full border p-2 rounded" min="1"
                   oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value < 1) this.value = 1;">
        </div>

        <div class="flex justify-end space-x-2 pt-2 border-t">
            <button type="button" onclick="cerrarModal()" class="bg-gray-400 hover:bg-gray-500 text-white px-4 py-2 rounded">Cancelar</button>
            <button type="button" onclick="guardarCambiosModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded font-medium">Guardar Cambios</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let detalles = [];

        document.getElementById('btnAgregar').addEventListener('click', function() {
            const select = document.getElementById('selectProducto');
            const inputCant = document.getElementById('inputCantidad');
            if (select.value === "") { alert("Por favor, selecciona un producto"); return; }
            
            const id = parseInt(select.value, 10);
            const nombre = select.options[select.selectedIndex].text.split(' ($')[0];
            const precio = parseFloat(select.options[select.selectedIndex].getAttribute('data-precio'));
            const cantidad = parseInt(inputCant.value, 10);
            
            let productoExistente = detalles.find(item => item.IdProducto === id);
            
            if (productoExistente) {
                productoExistente.Cantidad += cantidad;
                productoExistente.Subtotal = productoExistente.Precio * productoExistente.Cantidad;
            } else {
                detalles.push({
                    IdProducto: id,
                    Producto: nombre,
                    Precio: precio,
                    Cantidad: cantidad,
                    Subtotal: precio * cantidad
                });
            }
            renderTabla();
            inputCant.value = 1;
        });

        function renderTabla() {
            const tbody = document.getElementById('tablaDetallesBody');
            tbody.innerHTML = '';
            let totalGeneral = 0;
            
            detalles.forEach(item => {
                totalGeneral += item.Subtotal;
                tbody.innerHTML += `<tr>
                    <td class="p-2 border">${item.Producto}</td>
                    <td class="p-2 border text-center">${item.Cantidad}</td>
                    <td class="p-2 border text-right">$${item.Precio.toLocaleString('es-CL')}</td>
                    <td class="p-2 border text-right">$${item.Subtotal.toLocaleString('es-CL')}</td>
                    <td class="p-2 border text-center space-x-1">
                        <button type="button" onclick="abrirModalEditar(${item.IdProducto})" class="inline-flex items-center bg-blue-50 text-blue-600 p-1.5 rounded-md hover:bg-blue-100 transition" title="Actualizar">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" /></svg>
                        </button>
                        <button type="button" onclick="eliminarItem(${item.IdProducto})" class="inline-flex items-center bg-red-50 text-red-600 p-1.5 rounded-md hover:bg-red-100 transition" title="Eliminar">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
                        </button>
                    </td>
                </tr>`;
            });
            
            const iva = totalGeneral * 0.19;
            document.getElementById('resumenIVA').innerText = `$${Math.round(iva).toLocaleString('es-CL')}`;
            document.getElementById('resumenTotal').innerText = `$${Math.round(totalGeneral + iva).toLocaleString('es-CL')}`;
            document.getElementById('inputDetallesJson').value = JSON.stringify(detalles);
        }

        function eliminarItem(idProducto) {
            detalles = detalles.filter(item => item.IdProducto !== idProducto);
            renderTabla();
        }

        function abrirModalEditar(idProducto) {
            const item = detalles.find(p => p.IdProducto === idProducto);
            if (item) {
                document.getElementById('modalEditOriginalId').value = idProducto;
                document.getElementById('modalSelectProducto').value = idProducto;
                document.getElementById('modalInputCantidad').value = item.Cantidad;
                const modal = document.getElementById('modalEditar');
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        }

        function cerrarModal() {
            const modal = document.getElementById('modalEditar');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        function guardarCambiosModal() {
            const originalId = parseInt(document.getElementById('modalEditOriginalId').value, 10);
            const select = document.getElementById('modalSelectProducto');
            const inputCant = document.getElementById('modalInputCantidad');
            if (select.value === "") { alert("Por favor, selecciona un producto válido"); return; }
            
            const nuevoId = parseInt(select.value, 10);
            const nuevoNombre = select.options[select.selectedIndex].text.split(' ($')[0];
            const nuevoPrecio = parseFloat(select.options[select.selectedIndex].getAttribute('data-precio'));
            const nuevaCantidad = parseInt(inputCant.value, 10);
            
            const indexOriginal = detalles.findIndex(p => p.IdProducto === originalId);
            
            if (indexOriginal !== -1) {
                const indexDuplicado = detalles.findIndex((p, idx) => p.IdProducto === nuevoId && idx !== indexOriginal);
                
                if (indexDuplicado !== -1) {
                    detalles[indexDuplicado].Cantidad += nuevaCantidad;
                    detalles[indexDuplicado].Subtotal = detalles[indexDuplicado].Precio * detalles[indexDuplicado].Cantidad;
                    detalles.splice(indexOriginal, 1);
                } else {
                    detalles[indexOriginal] = {
                        IdProducto: nuevoId,
                        Producto: nuevoNombre,
                        Precio: nuevoPrecio,
                        Cantidad: nuevaCantidad,
                        Subtotal: nuevoPrecio * nuevaCantidad
                    };
                }
                renderTabla();
                cerrarModal();
            }
        }

        window.addEventListener('load', function() {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('collection_status') === 'approved') {
                setTimeout(function() {
                    window.location.href = "http://localhost:5215/Ventas";
                }, 3000);
            }
        });
    </script>
}