@page "{id:int?}"
@model webGestionInventario.Pages.AgregarEditarProveedorModel
@{
    ViewData["Title"] = Model.ProveedorActual.Id == 0 ? "Agregar Proveedor" : "Editar Proveedor";
}

<div class="max-w-4xl mx-auto bg-white p-6 rounded-lg shadow-md mt-5">
    <h2 class="text-2xl font-bold mb-4 text-gray-800">
        @(Model.ProveedorActual.Id == 0 ? "Agregar Proveedor" : "Actualizar Proveedor")
    </h2>

    <form method="post">
        <input type="hidden" asp-for="ProveedorActual.Id" />

        <div class="mb-4">
            <label class="block text-gray-700 font-bold mb-2">Nombre:</label>
            <input asp-for="ProveedorActual.Nombre" class="w-full border border-gray-300 rounded-md p-2"
                   oninput="this.value = this.value.replace(/[^a-zA-ZñÑáéíóúÁÉÍÓÚ\s]/g, '')"
                   placeholder="Ej: Juan Pérez" required />
        </div>

        <div class="mb-4">
            <label class="block text-gray-700 font-bold mb-2">Rut:</label>
            <input asp-for="ProveedorActual.Rut" class="w-full border border-gray-300 rounded-md p-2"
                   oninput="formatearRut(this)" placeholder="12.345.678-9" required />
        </div>

        @if (!string.IsNullOrEmpty(Model.MensajeError))
        {
            <div class="alert alert-danger p-2" role="alert">
                @Model.MensajeError
            </div>
        }

        <div class="mb-4">
            <label class="block text-gray-700 font-bold mb-2">Teléfono:</label>
            <input asp-for="ProveedorActual.Telefono" type="tel" class="w-full border border-gray-300 rounded-md p-2"
                   pattern="\+\d{7,14}"
                   maxlength="15"
                   placeholder="+56912345678"
                   onfocus="if(this.value === '') this.value = '+';"
                   oninput="formatearTelefono(this)" required />
        </div>

        <div class="mb-4">
            <label class="block text-gray-700 font-bold mb-2">Correo:</label>
            <input asp-for="ProveedorActual.Correo" type="email" class="w-full border border-gray-300 rounded-md p-2"
                   title="Debe ser un correo electrónico válido" placeholder="ejemplo@correo.com" required />
        </div>

        <div class="mb-4">
            <label class="block text-gray-700 font-bold mb-2">Empresa:</label>
            <input asp-for="ProveedorActual.Empresa" class="w-full border border-gray-300 rounded-md p-2"
                   placeholder="Ej: Empresa S.A." required />
        </div>

        <div class="mb-6">
            <label class="block text-gray-700 font-bold mb-2">Dirección:</label>
            <input asp-for="ProveedorActual.Direccion" class="w-full border border-gray-300 rounded-md p-2" placeholder="Ej: Calle falsa 123" required />
        </div>

        <div class="flex flex-row gap-2">
            <button type="submit" class="bg-blue-500 text-white px-6 py-2 rounded-md hover:bg-blue-600 transition">
                @(Model.ProveedorActual.Id == 0 ? "Guardar" : "Actualizar")
            </button>
            <a href="/Proveedores" class="inline-block bg-red-500 text-white px-6 py-2 rounded-md hover:bg-red-600 transition text-center no-underline">Cancelar</a>
        </div>
    </form>
    <script>
       
        function formatearRut(input) {
         
            let valor = input.value.replace(/[^0-9kK]/g, '').toUpperCase();

          
            if (valor.length === 0) {
                input.value = '';
                return;
            }

        
            let cuerpo = valor.slice(0, -1);
            let dv = valor.slice(-1);

           
            if (cuerpo.length > 0) {
             
                cuerpo = cuerpo.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                input.value = cuerpo + '-' + dv;
            } else {
                input.value = valor;
            }
        }

      
                    function formatearTelefono(input) {
                let valor = input.value;

                if (valor === "") {
                    input.value = "+";
                    return;
                }

                if (!valor.startsWith('+')) {
                    valor = '+' + valor.replace(/[^0-9]/g, '');
                } else {
                    let numeros = valor.substring(1).replace(/[^0-9]/g, '');
                    valor = '+' + numeros;
                }
                if (valor.length > 15) {
                    valor = valor.substring(0, 15);
                }

                input.value = valor;
            }
    </script>


</div>