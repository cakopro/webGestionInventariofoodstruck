@page
@model webGestionInventario.Pages.AgregarEditarProveedorModel
@{
    ViewData["Title"] = "Agregar/Editar";
}

<div class="max-w-6xl mx-auto bg-white p-6 rounded-lg shadow-md">
        <h1 class="text-xl text-black font-bold mb-4">Agregar/Editar Proveedor</h1>
        <form>
        <label for="nombre" class="block text-gray-700 font-bold mb-2">Nombre:</label>
        <input type="text" id="nombre" name="nombre" class="w-full border border-gray-300 rounded-md p-2 mb-4" />

        <label for="rut" class="block text-gray-700 font-bold mb-2">Rut:</label>
        <input type="text" id="rut" name="rut" class="w-full border border-gray-300 rounded-md p-2 mb-4" />
        
        <label for="telefono" class="blockquote text-gray-700 font-bold mb-2">Telefono:</label>
        <input type="number" id="telefono" name="telefono" class="w-full border border-gray-300 rounded-md p-2 mb-4" />

        <label for="correo" class="blockquote text-gray-700 font-bold mb-2">Correo:</label>
        <input type="email" id="correo" name="correo" class="w-full border border-gray-300 rounded-md p-2 mb-4" />

        <label for="Empresa" class="blockquote text-gray-700 font-bold mb-2">Empresa:</label>
        <input type="text" id="Empresa" name="Empresa" class="w-full border border-gray-300 rounded-md p-2 mb-4" />

        <label for="Direccion" class="blockquote text-gray-700 font-bold mb-2">Direccion:</label>
        <input type="text" id="Direccion" name="Direccion" class="w-full border border-gray-300 rounded-md p-2 mb-4" />
        </form>
    <div class="flex flex-row gap-2 pt-8">
        <button class="mt-4 bg-blue-500 text-white px-6 py-2 rounded-md hover:bg-blue-600 transition">Guardar</button>
        <a href="Proveedores" class="inline-block mt-4 bg-red-500 text-white px-6 py-2 rounded-md hover:bg-red-600 transition text-center" role="button">Cancelar</a>

        </div>
</div>