@page
@model webGestionInventario.Pages.AgregarEditarProveedorModel
@{
    ViewData["Title"] = "Agregar/Editar";
}

<div class="max-w-6xl mx-auto bg-white p-6 rounded-lg shadow-md">
        <h1 class="text-xl text-black font-bold mb-4">Agregar/Editar Proveedor</h1>

        <form method="post">
        <label  class="block text-gray-700 font-bold mb-2">Nombre:</label>
        <input asp-for="NuevoProveedor.Nombre" class="w-full border border-gray-300 rounded-md p-2 mb-4" />

        <label class="block text-gray-700 font-bold mb-2">Rut:</label>
        <input asp-for="NuevoProveedor.Rut" class="w-full border border-gray-300 rounded-md p-2 mb-4" />
        
        <label class="block text-gray-700 font-bold mb-2">Telefono:</label>
        <input asp-for="NuevoProveedor.Telefono" class="w-full border border-gray-300 rounded-md p-2 mb-4" />

        <label class="block text-gray-700 font-bold mb-2">Correo:</label>
        <input asp-for="NuevoProveedor.Correo" type="email" class="w-full border border-gray-300 rounded-md p-2 mb-4" />

        <label class="block text-gray-700 font-bold mb-2">Empresa:</label>
        <input asp-for="NuevoProveedor.Empresa" class="w-full border border-gray-300 rounded-md p-2 mb-4" />

        <label class="block text-gray-700 font-bold mb-2">Direccion:</label>
        <input asp-for="NuevoProveedor.Direccion" class="w-full border border-gray-300 rounded-md p-2 mb-4" />
        
        <div class="flex flex-row gap-2 pt-8">
            <button type="submit" class="mt-4 bg-blue-500 text-white px-6 py-2 rounded-md hover:bg-blue-600 transition">Guardar</button>
            <a href="Proveedores" class="inline-block mt-4 bg-red-500 text-white px-6 py-2 rounded-md hover:bg-red-600 transition text-center" role="button">Cancelar</a>

        </div>
    </form>
        
</div>