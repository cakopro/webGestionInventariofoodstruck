@page
@model webGestionInventario.Pages.loginModel
@{

    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Gestión de Inventario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-secondary d-flex align-items-center justify-content-center" style="height: 100vh;">

    <div class="card shadow-lg text-white" style="width: 400px; background-color: #1a2d54; border-radius: 10px;">
        <div class="card-body p-4 text-center">

            <h2 class="fw-bold mb-4">Login</h2>

            <div class="mb-4">
                <div class="bg-white text-dark rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <span style="font-size: 2rem;">👤</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="alert alert-danger p-2" role="alert">
                    @Model.MensajeError
                </div>
            }

            <form method="post">
                <div class="mb-3 text-start">
                    <label class="form-label">Usuario:</label>
                    <input asp-for="NombreUsuario" type="text" class="form-control" placeholder="Ingrese usuario" required />
                </div>

                <div class="mb-4 text-start">
                    <label class="form-label">Contraseña:</label>
                    <div class="input-group">
                        <input asp-for="Contrasena" type="password" id="inputContrasena" class="form-control border-end-0" placeholder="Ingrese contraseña" required />

                        <button class="btn border border-start-0" type="button" id="btnMostrarOjo" onclick="togglePassword()" style="background-color: white; color: #6c757d;">

                            <svg id="iconoOjo" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                            </svg>

                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-success w-100 fw-bold py-2">Ingresar</button>
            </form>

        </div>
    </div>

    <script>
        function togglePassword() {
            let input = document.getElementById('inputContrasena');

        
            if (input.type === 'password') {
                input.type = 'text';
            } else {
                input.type = 'password';
            }
        }
    </script>

</body>
</html>