@page
@model webGestionInventario.Pages.loginModel
@{

    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Gestión de Inventario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-secondary d-flex align-items-center justify-content-center" style="height: 100vh;">

    <div class="card shadow-lg text-white" style="width: 400px; background-color: #1a2d54; border-radius: 10px;">
        <div class="card-body p-4 text-center">

            <h2 class="fw-bold mb-4">Login</h2>

            <div class="mb-4">
                <div class="bg-white text-dark rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <span style="font-size: 2rem;">👤</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="alert alert-danger p-2" role="alert">
                    @Model.MensajeError
                </div>
            }

            <form method="post">
                <div class="mb-3 text-start">
                    <label class="form-label">Usuario:</label>
                    <input asp-for="NombreUsuario" type="text" class="form-control" placeholder="Ingrese usuario" required />
                </div>

                <div class="mb-3 text-start">
                    <label class="form-label">Contraseña:</label>
                    <input asp-for="Contrasena" type="password" id="inputContrasena" class="form-control" placeholder="Ingrese contraseña" required />
                </div>

                <div class="mb-4 text-start form-check">
                    <input type="checkbox" class="form-check-input" id="mostrarPass" onchange="document.getElementById('inputContrasena').type = this.checked ? 'text' : 'password'">
                    <label class="form-check-label" for="mostrarPass">mostrar</label>
                </div>

                <button type="submit" class="btn btn-success w-100 fw-bold py-2">Ingresar</button>
            </form>

        </div>
    </div>

</body>
</html>