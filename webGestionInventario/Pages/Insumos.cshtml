@page
@model webGestionInventario.Pages.InsumosModel
@{
    ViewData["Title"] = "Insumos";
}

<div class="max-w-6xl mx-auto bg-white p-6 rounded-lg shadow-md">
    <h1 class="text-xl text-black font-bold mb-4">Lista Insumo</h1>

    <form method="get" class="mb-4">
        <label class="inline-flex items-center cursor-pointer">
            <input type="checkbox" asp-for="MostrarInactivos" class="form-checkbox h-5 w-5 text-blue-600" onchange="this.form.submit()" />
            <span class="ml-2 text-gray-700 font-bold">Ver insumos inactivos (eliminados)</span>
        </label>
    </form>

    <table class="table-auto w-full border-collapse">
        <thead>
            <tr class="border p-2">
                <th class="p-3 text-left">Id</th>
                <th class="p-3 text-left">Nombre</th>
                <th class="p-3 text-left">Stock actual</th>
                <th class="p-3 text-left">Unidad Medida</th>
                <th class="p-3 text-left">Precio unitario</th>
                <th class="p-3 text-left">Fecha caducidad</th>
                <th class="p-3 text-left">Proveedor</th>
                <th class="p-3 text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ListaInsumos)
            {
                <tr class="border-b hover:bg-gray-100 transition">
                    <td class="p-3">@item.Id</td>
                    <td class="p-3">@item.Nombre</td>
                    <td class="p-3">@item.StockActual</td>
                    <td class="p-3">@item.UnidadMedida</td>
                    <td class="p-3">$@item.PrecioUnitario.ToString("N0", new System.Globalization.CultureInfo("es-CL"))</td>
                    <td class="p-3">@item.FechaCaducidad.ToShortDateString()</td>
                    <td class="p-3">@item.NombreProveedor</td>

                    <td class="p-3 text-center flex justify-center gap-2">
                        <a asp-page="./EditarInsumo" asp-route-id="@item.Id" class="bg-blue-500 text-white px-2 py-1 rounded hover:bg-blue-600">actualizar</a>

                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline;">
                            <button type="submit" class="bg-red-500 text-white px-2 py-1 rounded hover:bg-red-600" onclick="return confirm('¿Estás seguro de que deseas eliminar este insumo?');">eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a href="./AgregarInsumo" class="inline-block mt-4 bg-green-500 text-white px-6 py-2 rounded-md hover:bg-green-600 transition text-center" role="button">Agregar</a>
</div>