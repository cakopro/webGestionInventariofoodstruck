@page
@model webGestionInventario.Pages.InsumosModel
@{
    ViewData["Title"] = "Insumos";
}

<div class="max-w-6xl mx-auto bg-white p-6 rounded-lg shadow-md">
    <h1 class="text-xl text-black font-bold mb-4">Lista Insumo</h1>

    <form method="get" class="mb-4">
        <label class="inline-flex items-center cursor-pointer">
            <input type="checkbox" asp-for="MostrarInactivos" class="form-checkbox h-5 w-5 text-blue-600" onchange="this.form.submit()" />
            <span class="ml-2 text-gray-700 font-bold">Ver insumos inactivos (eliminados)</span>
        </label>
    </form>

    <table class="table-auto w-full border-collapse">
        <thead>
            <tr class="border p-2">
                <th class="p-3 text-left">Id</th>
                <th class="p-3 text-left">Nombre</th>
                <th class="p-3 text-left">Stock actual</th>
                <th class="p-3 text-left">Unidad Medida</th>
                <th class="p-3 text-left">Precio unitario</th>
                <th class="p-3 text-left">Fecha caducidad</th>
                <th class="p-3 text-left">Proveedor</th>
                <th class="p-3 text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ListaInsumos)
            {
                <tr class="border-b hover:bg-gray-100 transition">
                    <td class="p-3">@item.Id</td>
                    <td class="p-3">@item.Nombre</td>
                    <td class="p-3">@item.StockActual</td>
                    <td class="p-3">@item.UnidadMedida</td>
                    <td class="p-3">$@item.PrecioUnitario.ToString("N0", new System.Globalization.CultureInfo("es-CL"))</td>
                    <td class="p-3">@item.FechaCaducidad.ToShortDateString()</td>
                    <td class="p-3">@item.NombreProveedor</td>

                    <td class="p-3 text-center flex justify-center gap-2">
                        <a asp-page="./EditarInsumo" asp-route-id="@item.Id" class="inline-flex items-center gap-1 bg-blue-50 text-blue-600 p-2 rounded-md hover:bg-blue-100 transition" title="Actualizar">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
                            </svg>
                        </a>



                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline;">
                            <button type="submit" class="inline-flex items-center gap-1 bg-red-50 text-red-600 p-2 rounded-md hover:bg-red-100 transition" title="Eliminar" onclick="return confirm('¿Estás seguro de que deseas eliminar este proveedor?');">
                                   
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                                </svg>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a href="AgregarInsumo" class="inline-flex items-center gap-2 bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition font-semibold shadow-sm" role="button">
       
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Agregar
    </a>
</div>