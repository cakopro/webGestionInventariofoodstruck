@page
@model webGestionInventario.Pages.AgregarEditarInsumosModel
@{
    ViewData["Title"] = "Agregar/Editar";
}
<div class="max-w-6xl mx-auto bg-white p-6 rounded-lg shadow-md">
    <h1 class="text-xl text-black font-bold mb-4">Agregar/Editar Insumos</h1>
    <form>
        <label for="nombre" class="block text-gray-700 font-bold mb-2">Nombre:</label>
        <input type="text" id="nombre" name="nombre" class="w-full border border-gray-300 rounded-md p-2 mb-4" />

        <label for="stockActual" class="block text-gray-700 font-bold mb-2">Stock Actual:</label>
        <input type="number" id="stockActual" name="stockActual" class="w-full border border-gray-300 rounded-md p-2 mb-4" />
        
        <label for="precioUnitario" class="blockquote text-gray-700 font-bold mb-2">Precio Unitario:</label>
        <input type="number" id="precioUnitario" name="precioUnitario" class="w-full border border-gray-300 rounded-md p-2 mb-4" />

        <label class="block text-sm font-medium">Proveedores:</label>
        <select class="w-full border p-2 rounded"><option>Seleccionar...</option></select>

        <label for="fechaCaducidad" class="blockquote text-gray-700 font-bold mb-2">Fecha Caducidad:</label>
        <input type="date" id="fechaCaducidad" name="fechaCaducidad" class="w-full border border-gray-300 rounded-md p-2 mb-4" />
    </form>
    <div class="flex flex-row gap-2 pt-8">
        <button class="mt-4 bg-blue-500 text-white px-6 py-2 rounded-md hover:bg-blue-600 transition">Guardar</button>
        <a href="Insumos" class="inline-block mt-4 bg-red-500 text-white px-6 py-2 rounded-md hover:bg-red-600 transition text-center" role="button">Cancelar</a>

    </div>
</div>