@page
@model webGestionInventario.Pages.MenuModel
@{
    ViewData["Title"] = "Nuestro Menú - Food Truck";
}

<div class="max-w-4xl mx-auto p-4 md:p-6 space-y-6">
    
    <div class="text-center py-6 bg-gray-800  text-white rounded-2xl shadow-md">
        <h1 class="text-3xl font-black tracking-tight uppercase"> Menu food truck </h1>
        <p class="text-white-100 text-sm mt-1 font-medium">El mejor menu del mundo</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        @if (Model.ListaProductos == null || !Model.ListaProductos.Any())
        {
            <div class="col-span-full text-center py-8 text-gray-500 bg-white rounded-xl border border-dashed border-gray-200">
                <p class="text-lg font-medium">Por el momento no hay productos disponibles.</p>
            </div>
        }
        else
        {
            foreach (var item in Model.ListaProductos)
            {
                <div class="bg-white p-5 rounded-xl shadow-sm border border-gray-100 flex justify-between items-center hover:shadow-md transition-shadow duration-200">
                    <div class="space-y-1">
                        <h3 class="text-lg font-bold text-gray-900 tracking-tight">@item.Nombre</h3>
                    </div>
                    
                    <div class=" px-4 py-2 rounded-lg border border-black-200 shrink-0">
                        <span class="text-xl font-extrabold ">
                            $@item.PrecioVenta.ToString("F0").Replace(".", "").Replace(",", "")
                        </span>
                    </div>
                </div>
            }
        }
    </div>


</div>