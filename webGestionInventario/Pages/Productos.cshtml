@page
@model webGestionInventario.Pages.ProductosModel
@{
    ViewData["Title"] = "Productos";
}

<div class="max-w-6xl mx-auto bg-white p-6 rounded-lg shadow-md">
    <h1 class="text-xl text-black font-bold mb-4">Lista Productos</h1>

    <form method="get" class="mb-4">
        <label class="inline-flex items-center cursor-pointer">
            <input type="checkbox" asp-for="MostrarInactivos" class="form-checkbox h-5 w-5 text-blue-600" onchange="this.form.submit()" />
            <span class="ml-2 text-gray-700 font-bold">Ver productos inactivos (eliminados)</span>
        </label>
    </form>

    <table class="table-auto w-full border-collapse">
        <thead>
            <tr class="border p-2">
                <th class="p-3 text-left">Id</th>
                <th class="p-3 text-left">Producto</th>
                <th class="p-3 text-left">Precio</th>
                <th class="p-3 text-center">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.ListaProductos)
            {
                <tr class="border-b hover:bg-gray-200 transition cursor-pointer" onclick="cargarIngredientes(@item.Id)">
                    <td class="p-3">@item.Id</td>
                    <td class="p-3">@item.Nombre</td>
                    <td class="p-3">$@item.PrecioVenta.ToString("N0", new System.Globalization.CultureInfo("es-CL"))</td>
                    
                    <td class="p-3 text-center flex justify-center gap-2" onclick="event.stopPropagation()">
                        <a href="AgregarEditarProducto?id=@item.Id" class="bg-blue-500 text-white px-2 py-1 rounded hover:bg-blue-600">actualizar</a>

                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" style="display:inline;">
                            <button type="submit" class="bg-red-500 text-white px-2 py-1 rounded hover:bg-red-600" onclick="return confirm('¿Estás seguro de que deseas eliminar este producto?');">eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h1 class="text-xl text-black font-bold mb-4 mt-8">Lista Ingredientes</h1>
    <table class="table-auto w-full border-collapse">
        <thead>
            <tr class="border p-2">
                <th class="p-3 text-left">Ingrediente</th>
                <th class="p-3 text-left">Cantidad</th>
                <th class="p-3 text-left">Unidad</th>
            </tr>
        </thead>

        <tbody id="body-ingredientes" class="border-b hover:bg-gray-100 transition">
            <tr>
                <td colspan="3" class="p-3 text-center text-gray-500">Haz clic en un producto para ver sus ingredientes</td>
            </tr>
        </tbody>
    </table>

    <a href="AgregarEditarProducto" class="inline-block mt-4 bg-green-500 text-white px-6 py-2 rounded-md hover:bg-green-600 transition text-center" role="button">Agregar</a>
</div>

<script>
    function cargarIngredientes(id) {
        
        fetch(`?handler=CargarIngredientes&id=${id}`)
            .then(response => response.json())
            .then(data => {
                const tbody = document.getElementById("body-ingredientes");
                tbody.innerHTML = "";

                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" class="p-3 text-center">No tiene ingredientes registrados</td></tr>';
                } else {
                    data.forEach(item => {
                        tbody.innerHTML += `
                            <tr class="border-b">
                                <td class="p-3">${item.nombre}</td>
                                <td class="p-3">${item.cantidad}</td>
                                <td class="p-3">${item.unidad}</td>
                            </tr>`;
                    });
                }
            })
            .catch(error => console.error('Error:', error));
    }
</script>

