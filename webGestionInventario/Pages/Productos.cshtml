@page
@model webGestionInventario.Pages.ProductosModel
@{
    ViewData["Title"] = "Productos";

}

<div class="max-w-6xl mx-auto bg-white p-6 rounded-lg shadow-md">
    <h1 class="text-xl text-black font-bold mb-4">Lista Productos</h1>
    <table class="table-auto w-full border-collapse">
        <thead>
            <tr class="border p-2">
                <th class="p-3 text-left">Id</th>
                <th class="p-3 text-left">Producto</th>
                <th class="p-3 text-left">Precio</th>
                <th class="p-3 text-center">Acciones</th>
            </tr>
        </thead>

        <tbody>
            <tr class="border-b hover:bg-gray-100 transition">
                <td class="p-3">1</td>
                <td class="p-3">Completo</td>
                <td class="p-3">1500</td>
            
                <td class="p-3 border flex justify-center gap-2">
                    <button class="bg-red-500 text-white px-3 py-1 rounded text-sm hover:bg-red-600">eliminar</button>
                    <button class="bg-blue-500 text-white px-3 py-1 rounded text-sm hover:bg-blue-600">actualizar</button>
                </td>
            </tr>

        </tbody>
    </table>
    <h1 class="text-xl text-black font-bold mb-4">Lista Ingredientes</h1>
    <table class="table-auto w-full border-collapse">
        <thead>
            <tr class="border p-2">
                <th class="p-3 text-left">Ingrediente</th>
                <th class="p-3 text-left">Cantidad</th>
                <th class="p-3 text-left">Unidad</th>
            </tr>
        </thead>

        <tbody>
            <tr class="border-b hover:bg-gray-100 transition">
                <td class="p-3">vienesa</td>
                <td class="p-3">123</td>
                <td class="p-3">Unidades</td>
            </tr>

        </tbody>
    </table>
    <a href="AgregarEditarProducto" class="inline-block mt-4 bg-green-500 text-white px-6 py-2 rounded-md hover:bg-green-600 transition text-center" role="button">Agregar</a>

</div>

